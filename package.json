{
  "name": "px-converter",
  "version": "0.8.1",
  "author": "Alessio Michelini",
  "bin": {
    "px-converter": "./bin/run"
  },
  "bugs": "https://github.com/darkmavis1980/px-converter/issues",
  "dependencies": {
    "commander": "^13.1.0",
    "inquirer": "^8.2.7",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/inquirer": "^8.2.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.7",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.53.1",
    "auto-changelog": "^2.5.0",
    "eslint-plugin-import": "^2.32.0",
    "global": "^4.4.0",
    "globals": "^17.0.0",
    "globby": "^16.1.0",
    "jest": "^29.7.0",
    "nyc": "^17.1.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/darkmavis1980/px-converter",
  "keywords": [
    "converter"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "repository": "darkmavis1980/px-converter",
  "scripts": {
    "posttest": "npm run eslint",
    "build": "tsc -b",
    "prepack": "rm -rf lib && npm run build",
    "test": "jest --verbose",
    "test:watch": "jest --verbose --watch",
    "changelog": "auto-changelog",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "eslint": "npx eslint . --ext .ts",
    "prettier:check": "npx prettier ./src/**/*.ts ./test/**/*.test.ts --check",
    "prettier:write": "npx prettier ./src/**/*.ts ./test/**/*.test.ts --write"
  },
  "types": "lib/index.d.ts",
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "changelog.tpl.hbs",
    "unreleased": true,
    "commitLimit": 10,
    "includeBranch": [
      "main",
      "dev"
    ]
  }
}
