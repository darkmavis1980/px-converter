{
  "name": "px-converter",
  "version": "1.0.0",
  "type": "module",
  "author": "Alessio Michelini",
  "bin": {
    "px-converter": "./bin/run"
  },
  "bugs": "https://github.com/darkmavis1980/px-converter/issues",
  "dependencies": {
    "commander": "^15.1.0",
    "inquirer": "^8.2.7",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/inquirer": "^8.2.13",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.53.1",
    "auto-changelog": "^2.7.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "globby": "^16.2.4",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "/bin",
    "/lib"
  ],
  "homepage": "https://github.com/darkmavis1980/px-converter",
  "keywords": [
    "converter"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "repository": "darkmavis1980/px-converter",
  "scripts": {
    "posttest": "npm run eslint",
    "build": "tsc -b",
    "prepack": "rm -rf lib && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "auto-changelog",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "eslint": "npx eslint . --ext .ts",
    "prettier:check": "npx prettier ./src/**/*.ts ./test/**/*.test.ts --check",
    "prettier:write": "npx prettier ./src/**/*.ts ./test/**/*.test.ts --write"
  },
  "types": "lib/index.d.ts",
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "changelog.tpl.hbs",
    "unreleased": true,
    "commitLimit": 10,
    "includeBranch": [
      "main",
      "dev"
    ]
  }
}
